/** Collects and presents the additional system monitors in one terminal window. */
public module system_monitor {

  using std;

  /** Recognizes the views accepted by the command line. */
  function valid_monitor(name: const ref String) bool {
    return name.equals_literal("menu") or name.equals_literal("process") or
      name.equals_literal("disk") or name.equals_literal("service") or
      name.equals_literal("network") or name.equals_literal("temperature");
  }

  /** Maps the selection screen shortcuts to monitor names. */
  function monitor_choice(ch: u8) String throws {
    if (ch == b'1') {
      return String("process");
    }
    if (ch == b'2') {
      return String("disk");
    }
    if (ch == b'3') {
      return String("service");
    }
    if (ch == b'4') {
      return String("network");
    }
    if (ch == b'5') {
      return String("temperature");
    }
    return String("menu");
  }

  /** Draws bounded lines without allowing host data to emit terminal commands. */
  function panel(
    a: ref HeapAllocator,
    terminal: ref Terminal,
    lines: ref Vec<String>,
    first: i64,
    name: const ref String
  ) void throws {
    terminal.size(a);
    var out = String("");
    var count = lines.size();
    if (terminal.active) {
      out.append("\x1b[H\x1b[2J");
      terminal.tabs(a, out, name);
      count = terminal.rows - 2;
      if (count < 1) {
        count = 1;
      }
    }
    for (var i: i64 = first; i < lines.size() and i < first + count; i = i + 1) {
      var width: i64 = 4096;
      if (terminal.active) {
        width = terminal.columns - 1;
      }
      if (width < 1) {
        width = 1;
      }
      out.append(safe_text(a, lines.get(i), width));
      out.append("\r\n");
    }
    (output(out));

    return;
  }

  /** Finds a monitor's position in the shared terminal and browser tab order. */
  function monitor_index(name: const ref String) i64 {
    if (name.equals_literal("disk")) {
      return 1;
    }
    if (name.equals_literal("service")) {
      return 2;
    }
    if (name.equals_literal("network")) {
      return 3;
    }
    if (name.equals_literal("temperature")) {
      return 4;
    }
    return 0;
  }

  /** Holds cumulative traffic counters for one interface. */
  class Traffic {
    var name: String;
    var received: i64 = 0;
    var sent: i64 = 0;
    var errors: i64 = 0;
    var drops: i64 = 0;

    /** Initializes owned storage and reports allocation failure. */
    init() throws {
      this.name = String("");
    }
  }

  /** Parses a Linux interface row, preserving names and rejecting short records. */
  function parse_traffic(a: ref HeapAllocator, line: const ref String) Traffic throws {
    var colon: i64 = -1;
    match line.rfind_char(b':') {
      Option.Some(n) => {
        colon = n;
      },
      Option.None => {}
    };
    if (colon < 1) {
      throw Error(1, "missing interface separator");
    }
    var traffic = Traffic();
    traffic.name = line.substr(a, 0, colon);
    traffic.name.trim();
    var rest = line.substr(a, colon + 1, line.length() - colon - 1);

    var parts = rest.split_whitespace(a);
    if (parts.size() < 16) {
      throw Error(1, "short interface counters");
    }
    traffic.received = number(parts.get(0));
    traffic.sent = number(parts.get(8));
    traffic.errors = number(parts.get(2)) + number(parts.get(10));
    traffic.drops = number(parts.get(3)) + number(parts.get(11));
    return traffic;
  }

  /** Computes bytes per second only when a valid previous counter exists. */
  function traffic_rate(before: i64, after: i64, millis: i64) f64 {
    if (millis <= 0 or after < before) {
      return -1.0;
    }
    return _convert<f64>(after - before) * 1000.0 / _convert<f64>(millis);
  }

  /** Reads an optional sensor attribute without failing the entire view. */
  function attribute(a: ref HeapAllocator, path: const ref String) String throws {
    var file = path.clone(a);

    var operation_completed_7 = false;
    try {
      var value = std.io.read_to_string(a, file);
      operation_completed_7 = true;
      value.trim();
      return value;
    } catch {
      if (operation_completed_7) {
        throw;
      }
      return String("");
    }
  }

  /** Joins a sysfs directory and an attribute name. */
  function resource_path(
    a: const ref HeapAllocator,
    base: const ref String,
    name: const ref String
  ) String throws {
    var path = base.clone(a);
    path.append("/");
    path.append(name);
    return path;
  }

  /** Formats a valid millidegree reading as Celsius. */
  function format_temperature(value: ref String) String throws {
    var degrees = _convert<f64>(number(value)) / 1000.0;
    if (degrees < 0.0) {
      var text = String("-");
      text.append(decimal(-degrees));
      return text;
    }
    return decimal(degrees);
  }

  /** Converts a readable Linux millidegree attribute to Celsius. */
  function temperature_text(value: ref String) String throws {
    try {
      var value = format_temperature(value);
      return value;
    } catch {
      return String("N/A");
    }
  }

  /** Joins utility fields while preserving names that contain spaces. */
  function joined_fields(
    a: const ref HeapAllocator,
    fields: ref Vec<String>,
    first: i64,
    last: i64
  ) String throws {
    var text = String("");
    for (var i = first; i < last; i = i + 1) {
      if (i > first) {
        text.append(" ");
      }
      text.append(vector_read(fields, i));
    }
    return text;
  }

  /** Parses POSIX df columns into byte counts and a separate mount name. */
  function disk_row(a: ref HeapAllocator, line: const ref String) std.json.Json throws {
    var fields = line.split_whitespace(a);
    for (var i: i64 = 1; i + 4 < fields.size(); i = i + 1) {
      var capacity: const ref String = vector_read(fields, i + 3);
      if (not capacity.ends_with("%") and not capacity.equals_literal("-")) {
        continue;
      }
      var total = number(vector_read(fields, i));
      var used = number(vector_read(fields, i + 1));
      var available = number(vector_read(fields, i + 2));
      var percent: i64 = -1;
      if (capacity.ends_with("%")) {
        var percent_text = capacity.substr(a, 0, capacity.length() - 1);

        percent = number(percent_text);
        if (percent < 0) {
          throw Error(1, "invalid filesystem percentage");
        }
      }
      if (total < 0 or used < 0) {
        throw Error(1, "invalid filesystem counters");
      }
      var row = std.json.create_json_object(a);
      row.set(
        String("filesystem"),
        std.json.Json(joined_fields(a, fields, 0, i))
      );
      row.set(
        String("mount"),
        std.json.Json(joined_fields(a, fields, i + 4, fields.size()))
      );
      row.set(
        String("total_bytes"),
        std.json.Json(total * 1024)
      );
      row.set(
        String("used_bytes"),
        std.json.Json(used * 1024)
      );
      row.set(
        String("available_bytes"),
        std.json.Json(available * 1024)
      );
      if (percent < 0) {
        row.set(String("used_percent"), std.json.Json());
      } else {
        row.set(
          String("used_percent"),
          std.json.Json(percent)
        );
      }
      return row;
    }
    throw Error(1, "malformed filesystem row");
  }

  /** Preserves the systemd unit identity, state columns and description. */
  function service_row(a: ref HeapAllocator, line: const ref String) std.json.Json throws {
    var fields = line.split_whitespace(a);
    if (fields.size() < 4 or not (vector_read(fields, 0)).ends_with(".service")) {
      throw Error(1, "malformed service row");
    }
    var row = std.json.create_json_object(a);
    row.set(
      String("unit"),
      std.json.create_json_string(a, vector_read(fields, 0))
    );
    row.set(
      String("load"),
      std.json.create_json_string(a, vector_read(fields, 1))
    );
    row.set(
      String("active"),
      std.json.create_json_string(a, vector_read(fields, 2))
    );
    row.set(
      String("sub"),
      std.json.create_json_string(a, vector_read(fields, 3))
    );
    row.set(
      String("description"),
      std.json.Json(joined_fields(a, fields, 4, fields.size()))
    );
    return row;
  }

  /** Encodes missing rate baselines as null instead of a fabricated zero. */
  function rate_json(rate: f64) std.json.Json {
    if (rate < 0.0) {
      return std.json.Json();
    }
    return std.json.Json(rate);
  }

  /** Converts signed millidegrees to Celsius, keeping unreadable values null. */
  function degrees_json(value: const ref String) std.json.Json throws {
    var operation_completed_6 = false;
    try {
      var value = number(value);
      operation_completed_6 = true;
      return std.json.Json(_convert<f64>(value) / 1000.0);
    } catch {
      if (operation_completed_6) {
        throw;
      }
      return std.json.Json();
    }
  }

  /** Describes a sensor without treating a missing threshold as a healthy reading. */
  function sensor_row(
    a: ref HeapAllocator,
    name: const ref String,
    value: const ref String,
    critical: const ref String
  ) std.json.Json throws {
    var row = std.json.create_json_object(a);
    row.set(
      String("sensor"),
      std.json.create_json_string(a, name)
    );
    row.set(String("celsius"), degrees_json(value));
    row.set(
      String("critical_celsius"),
      degrees_json(critical)
    );
    var status = String("unavailable");

    var operation_completed_5 = false;
    try {
      var value = number(value);
      operation_completed_5 = true;
      var current = value;
      status = String("no threshold");

      var operation_completed_4 = false;
      try {
        var value = number(critical);
        operation_completed_4 = true;
        var limit = value;
        status = String("normal");
        if (current >= limit) {
          status = String("critical");
        }
      } catch {
        if (operation_completed_4) {
          throw;
        }
      }
    } catch {
      if (operation_completed_5) {
        throw;
      }
    }

    row.set(String("status"), std.json.Json(status));
    return row;
  }

  /** Owns the latest resource rows and previous interface counters. */
  class Resources {
    var lines: Vec<String>;
    var previous: Vec<Traffic>;
    var rows: std.json.Json = std.json.Json();
    var message: String;
    var elapsed: i64 = -1;
    var samples: i64 = 0;

    /** Creates empty collector state. */
    init(a: ref HeapAllocator) throws {
      this.message = String("");

      this.lines = Vec<String>(a, 32);
      this.rows = std.json.create_json_array(a);
      this.message = String("");
      this.previous = Vec<Traffic>(a, 16);
    }

    /** Clears rate baselines when the selected view changes. */
    method reset(a: ref HeapAllocator) void throws {
      this.lines = Vec<String>(a, 32);
      this.rows = std.json.create_json_array(a);
      this.message = String("");
      this.previous = Vec<Traffic>(a, 16);
      this.elapsed = -1;
      this.samples = 0;

      return;
    }

    /** Runs a fixed read-only system utility without shell interpolation. */
    method command(
      a: ref HeapAllocator,
      program: const ref String,
      arguments: const ref String
    ) void throws {
      var cmd = std.process.Command(a, program);
      var parts = arguments.split_whitespace(a);
      for (var i: i64 = 0; i < parts.size(); i = i + 1) {
        cmd.add_arg(parts.get(i));
      }
      var result = cmd.output();
      var rows = result.stdout().split(a, 10u8);
      for (var i: i64 = 0; i < rows.size(); i = i + 1) {
        if (not (vector_read(rows, i)).is_empty()) {
          this.lines.push(
            (vector_read(rows, i)).clone(a)
          );
        }
      }
      if ((result.status()) != 0) {
        this.message = String("Unavailable: system utility could not complete.");
        this.lines.push(this.message.clone(a));

        var errors = result.stderr().split(a, 10u8);
        if (errors.size() > 0) {
          this.lines.push(
            (vector_read(errors, 0)).clone(a)
          );

          this.message.append(" ");
          this.message.append(vector_read(errors, 0));
        }
      }

      return;
    }

    /** Reads filesystem capacity in portable POSIX blocks. */
    method disks(a: ref HeapAllocator) void throws {
      this.lines.push(
        String("Filesystem usage (1024-byte blocks); Available excludes reserved space.")
      );

      this.lines.push(String(""));

      this.command(
        a,
        String("df"),
        String("-Pk")
      );
      for (var i: i64 = 3; i < this.lines.size(); i = i + 1) {
        var operation_completed_3 = false;
        try {
          var value = disk_row(a, this.lines.get(i));
          operation_completed_3 = true;
          this.rows.push(value);
        } catch {
          if (operation_completed_3) {
            throw;
          }
        }
      }
      if (this.rows.len() == 0 and this.message.is_empty()) {
        this.message = String("No filesystem measurements available.");
      }

      return;
    }

    /** Lists all loaded system services, including inactive and failed units. */
    method services(a: ref HeapAllocator) void throws {
      if (_target_is("linux")) {
        this.lines.push(
          String("System services: ACTIVE / SUB / LOAD / UNIT")
        );

        this.lines.push(
          String("Includes inactive loaded units; failed units show 'failed'.")
        );

        this.command(
          a,
          String("systemctl"),
          String("list-units --type=service --all --no-pager --plain --no-legend")
        );
        for (var i: i64 = 2; i < this.lines.size(); i = i + 1) {
          var line: ref String = this.lines.get(i);
          var fields = line.split_whitespace(a);
          if (fields.size() >= 4 and (vector_read(fields, 0)).ends_with(".service")) {
            var parsed = service_row(a, line);
            var row = padded(vector_read(fields, 2), 11);
            row.append(padded(vector_read(fields, 3), 14));
            row.append(padded(vector_read(fields, 1), 11));
            row.append(vector_read(fields, 0));
            line = row;
            this.rows.push(parsed);
          }
        }
      } else {
        this.lines.push(
          String(
            "Launch agents in the current launchd domain: PID / last exit status / label"
          )
        );

        this.command(
          a,
          String("launchctl"),
          String("list")
        );
        this.message = String("Structured service metrics require systemd on Linux.");
      }

      return;
    }

    /** Reads per-interface traffic and calculates rates using actual elapsed time. */
    method network(a: ref HeapAllocator, now: i64) void throws {
      if (not _target_is("linux")) {
        this.lines.push(
          String("Interface totals from netstat; bytes, packets, errors and drops.")
        );

        this.command(
          a,
          String("netstat"),
          String("-ibn")
        );
        this.message = String("Structured network metrics require Linux procfs.");
        return;
      }
      this.lines.push(
        String("INTERFACE  STATE  RX KiB/s  TX KiB/s  RX MiB  TX MiB  ERRORS  DROPS")
      );

      this.lines.push(
        String("N/A rates need a baseline or indicate a counter reset.")
      );

      var text = std.io.read_to_string(a, "/proc/net/dev");
      var rows = text.split(a, 10u8);
      var current = Vec<Traffic>(a, 16);
      for (var i: i64 = 2; i < rows.size(); i = i + 1) {
        if ((vector_read(rows, i)).is_empty()) {
          continue;
        }
        var t = parse_traffic(a, vector_read(rows, i));
        var rx: f64 = -1.0;
        var tx: f64 = -1.0;
        for (var j: i64 = 0; j < this.previous.size(); j = j + 1) {
          var old: ref Traffic = this.previous.get(j);
          if (old.name.equals(t.name)) {
            rx = traffic_rate(old.received, t.received, now - this.elapsed);
            tx = traffic_rate(old.sent, t.sent, now - this.elapsed);
          }
        }
        var record = std.json.create_json_object(a);
        record.set(
          String("interface"),
          std.json.create_json_string(a, t.name)
        );
        record.set(
          String("rx_bytes_per_sec"),
          rate_json(rx)
        );
        record.set(
          String("tx_bytes_per_sec"),
          rate_json(tx)
        );
        record.set(
          String("rx_bytes"),
          std.json.Json(t.received)
        );
        record.set(
          String("tx_bytes"),
          std.json.Json(t.sent)
        );
        record.set(
          String("errors"),
          std.json.Json(t.errors)
        );
        record.set(String("drops"), std.json.Json(t.drops));
        if (rx >= 0.0) {
          rx = rx / 1024.0;
        }
        if (tx >= 0.0) {
          tx = tx / 1024.0;
        }
        var path = String("/sys/class/net/");
        path.append(t.name);
        path.append("/operstate");
        var state = attribute(a, path);
        if (state.is_empty()) {
          state = String("N/A");
        }
        record.set(
          String("state"),
          std.json.create_json_string(a, state)
        );
        this.rows.push(record);
        var row = t.name.clone(a);
        row.append("  ");
        row.append(state);
        row.append("  ");
        row.append(decimal(rx));
        row.append("  ");
        row.append(decimal(tx));
        row.append("  ");
        row.append(decimal(_convert<f64>(t.received) / 1048576.0));

        row.append("  ");
        row.append(decimal(_convert<f64>(t.sent) / 1048576.0));
        row.append("  ");
        row.append(t.errors);
        row.append("  ");
        row.append(t.drops);
        this.lines.push(row);
        current.push(t);
      }
      this.previous = current;
      this.elapsed = now;

      return;
    }

    /** Adds a sensor with its optional critical threshold. */
    method sensor(
      a: ref HeapAllocator,
      name: String,
      path: const ref String,
      critical_path: const ref String
    ) void throws {
      var value = attribute(a, path);
      var critical = attribute(a, critical_path);
      this.rows.push(sensor_row(a, name, value, critical));
      var row = name;
      row.append("  ");
      row.append(temperature_text(value));
      row.append(" C  critical ");
      row.append(temperature_text(critical));
      row.append(" C");

      var operation_completed_2 = false;
      try {
        var limit = number(critical);
        operation_completed_2 = true;

        var operation_completed_1 = false;
        try {
          var current = number(value);
          operation_completed_1 = true;
          if (current >= limit) {
            row.append("  CRITICAL");
          }
        } catch {
          if (operation_completed_1) {
            throw;
          }
        }
      } catch {
        if (operation_completed_2) {
          throw;
        }
      }

      this.lines.push(row);

      return;
    }

    /** Collects readable temperature attributes from one hardware monitor. */
    method hwmon_device(
      a: ref HeapAllocator,
      base: ref String,
      device: const ref String
    ) i64 throws {
      var sensors: i64 = 0;
      var chip = attribute(
        a,
        resource_path(a, base, String("name"))
      );
      var files = std.io.read_dir(a, base);
      for (var j: i64 = 0; j < files.size(); j = j + 1) {
        var name: ref String = (files.get(j)).name();
        if (not name.starts_with("temp") or not name.ends_with("_input")) {
          continue;
        }
        var stem = name.substr(a, 0, name.length() - 6);
        var label_name = stem.clone(a);
        label_name.append("_label");
        var label = attribute(a, resource_path(a, base, label_name));
        if (label.is_empty()) {
          label = stem.clone(a);
        }
        var title = device.clone(a);
        title.append("/");
        title.append(chip);
        title.append("/");
        title.append(label);
        var crit_name = stem.clone(a);
        crit_name.append("_crit");
        this.sensor(
          a,
          title,
          resource_path(a, base, name),
          resource_path(a, base, crit_name)
        );
        sensors = sensors + 1;
      }

      return sensors;
    }

    /** Discovers Linux hardware sensors and falls back to thermal zones. */
    method temperatures(a: ref HeapAllocator) void throws {
      this.lines.push(
        String("SENSOR  TEMPERATURE  CRITICAL THRESHOLD")
      );

      if (not _target_is("linux")) {
        this.message = String(
          "Unavailable: macOS does not expose temperatures through a supported public API."
        );
        this.lines.push(this.message.clone(a));

        return;
      }
      var sensors: i64 = 0;
      if (std.io.exists("/sys/class/hwmon")) {
        var devices = std.io.read_dir(a, "/sys/class/hwmon");
        for (var i: i64 = 0; i < devices.size(); i = i + 1) {
          var device: ref std.io.DirEntry = devices.get(i);
          var base = resource_path(
            a,
            String("/sys/class/hwmon"),
            device.name()
          );
          try {
            var value = this.hwmon_device(a, base, device.name());
            sensors = sensors + value;
          } catch {}
        }
      }
      if (sensors == 0 and std.io.exists("/sys/class/thermal")) {
        var zones = std.io.read_dir(a, "/sys/class/thermal");
        for (var i: i64 = 0; i < zones.size(); i = i + 1) {
          var zone: ref std.io.DirEntry = zones.get(i);
          if (not zone.name().starts_with("thermal_zone")) {
            continue;
          }
          var base = resource_path(
            a,
            String("/sys/class/thermal"),
            zone.name()
          );
          var label = zone.name().clone(a);
          label.append("/");
          label.append(
            attribute(
              a,
              resource_path(a, base, String("type"))
            )
          );

          this.sensor(
            a,
            label,
            resource_path(a, base, String("temp")),
            String("")
          );
          sensors = sensors + 1;
        }
      }
      if (sensors == 0) {
        this.message = String(
          "Unavailable: no readable hardware temperature sensors were exposed by this host."
        );
        this.lines.push(this.message.clone(a));
      }

      return;
    }

    /** Collects the selected resource view and propagates unavailable data. */
    method collect_view(a: ref HeapAllocator, name: const ref String, now: i64) void throws {
      if (name.equals_literal("disk")) {
        this.disks(a);
      } else if (name.equals_literal("service")) {
        this.services(a);
      } else if (name.equals_literal("network")) {
        this.network(a, now);
      } else if (name.equals_literal("temperature")) {
        this.temperatures(a);
      }

      return;
    }

    /** Collects one view and keeps failures visible without exiting the monitor. */
    method sample(a: ref HeapAllocator, name: const ref String, now: i64) void throws {
      this.lines = Vec<String>(a, 32);
      this.rows = std.json.create_json_array(a);
      this.message = String("");
      try {
        this.collect_view(a, name, now);
      } catch (e: std.Error) {
        var message = String("Unavailable: ");
        message.append(e.message());

        this.message = message.clone(a);
        this.lines.push(message);
      } catch (e: std.AllocationError) {
        var message = String("Unavailable: ");
        message.append(e.message());

        this.message = message.clone(a);
        this.lines.push(message);
      } catch (e: std.InvalidArgumentError) {
        var message = String("Unavailable: ");
        message.append(e.message());

        this.message = message.clone(a);
        this.lines.push(message);
      } catch (e: std.OverflowError) {
        var message = String("Unavailable: ");
        message.append(e.message());

        this.message = message.clone(a);
        this.lines.push(message);
      } catch (e: std.IndexOutOfBoundsError) {
        var message = String("Unavailable: ");
        message.append(e.message());

        this.message = message.clone(a);
        this.lines.push(message);
      } catch (e: std.NotFoundError) {
        var message = String("Unavailable: ");
        message.append(e.message());

        this.message = message.clone(a);
        this.lines.push(message);
      } catch (e: std.EmptyError) {
        var message = String("Unavailable: ");
        message.append(e.message());

        this.message = message.clone(a);
        this.lines.push(message);
      } catch (e: std.IOError) {
        var message = String("Unavailable: ");
        message.append(e.message());

        this.message = message.clone(a);
        this.lines.push(message);
      } catch (e: std.ConversionError) {
        var message = String("Unavailable: ");
        message.append(e.message());

        this.message = message.clone(a);
        this.lines.push(message);
      } catch (e: std.DivisionByZeroError) {
        var message = String("Unavailable: ");
        message.append(e.message());

        this.message = message.clone(a);
        this.lines.push(message);
      } catch (e: std.ArithmeticError) {
        var message = String("Unavailable: ");
        message.append(e.message());

        this.message = message.clone(a);
        this.lines.push(message);
      } catch (e: std.json.JsonError) {
        var message = String("Unavailable: ");
        message.append(e.message());

        this.message = message.clone(a);
        this.lines.push(message);
      } catch (e: std.xml.XmlError) {
        var message = String("Unavailable: ");
        message.append(e.message());

        this.message = message.clone(a);
        this.lines.push(message);
      } catch (e: std.ProtoDecodeError) {
        var message = String("Unavailable: ");
        message.append(e.message());

        this.message = message.clone(a);
        this.lines.push(message);
      }
      this.samples = this.samples + 1;

      return;
    }

    /** Renders a scrollable page while preserving the title and navigation hints. */
    method draw(a: ref HeapAllocator, terminal: ref Terminal, name: const ref String) void throws {
      if (terminal.paused) {
        return;
      }
      terminal.size(a);
      var page = Vec<String>(a, 32);
      var title = String("SYSTEM MONITOR / ");
      title.append(name);
      title.append("  |  sample ");
      title.append(this.samples);
      page.push(title);
      if (terminal.tabs_focused) {
        page.push(
          String("TABS: Left/Right choose  Down/Enter view  1-5 jump  q quit")
        );
      } else {
        page.push(
          String("1-5 tabs  Tab focus  Up/Down scroll  space pause  q quit")
        );
      }
      var visible = terminal.rows - 6;
      if (visible < 1) {
        visible = 1;
      }
      var max_scroll = this.lines.size() - visible;
      if (max_scroll < 0) {
        max_scroll = 0;
      }
      if (terminal.selected_row > max_scroll) {
        terminal.selected_row = max_scroll;
      }
      var first = terminal.selected_row;
      if (not terminal.active) {
        first = 0;
        visible = this.lines.size();
      }
      for (var i = first; i < this.lines.size() and i < first + visible; i = i + 1) {
        page.push((this.lines.get(i)).clone(a));
      }
      var footer = String("Rows ");
      footer.append(first + 1);
      footer.append(" / ");
      footer.append(this.lines.size());
      page.push(footer);
      panel(a, terminal, page, 0, name);

      return;
    }
  }
}
