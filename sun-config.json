{
  "root": true,
  "dependencies": [
    {
      "target": {
        "x86_64-linux-gnu": {
          "package": "namo-robotics/sun_serve",
          "library": "namo-robotics/sun_serve",
          "url": "https://github.com/namo-robotics/sun_serve/releases/download/dev/sun_serve-x86_64-linux-gnu.moon",
          "hash": "ad5b5eb01383ed21d7423252a81ede4bfdca4d7fd74818a20005a2166a0ba934"
        }
      }
    }
  ],
  "entrypoints": [
    {
      "path": "${SUN_BUILD}/main.sun",
      "type": "binary",
      "name": "system_monitor",
      "steps": [
        "version",
        "entrypoint"
      ],
      "export": true,
      "compile_args": {
        "default": [
          "--static"
        ],
        "target": {
          "arm64-apple-darwin": [
            "--dynamic",
            "-lproc"
          ]
        }
      }
    },
    {
      "path": "tests/acceptance.sun",
      "type": "binary",
      "name": "acceptance"
    }
  ],
  "packages": [
    {
      "name": "system_monitor",
      "entrypoints": [
        "system_monitor"
      ],
      "resources": [
        {
          "path": "assets/dashboard.html",
          "destination": "share/system_monitor/dashboard.html"
        }
      ]
    }
  ],
  "package_id": "namo-robotics/system_monitor",
  "steps": [
    {
      "name": "version",
      "command": [
        "bash",
        "scripts/build-version.sh",
        "${SUN_BUILD}"
      ],
      "inputs": [
        "scripts/build-version.sh"
      ],
      "outputs": [
        "${SUN_BUILD}/version.sun"
      ]
    },
    {
      "name": "entrypoint",
      "command": [
        "bash",
        "scripts/build-web.sh",
        "${SUN_BUILD}"
      ],
      "inputs": [
        "src/main.sun",
        "scripts/build-web.sh"
      ],
      "outputs": [
        "${SUN_BUILD}/main.sun"
      ]
    }
  ],
  "exports": [
    {
      "path": "assets/dashboard.html",
      "destination": "share/system_monitor/dashboard.html"
    }
  ]
}
