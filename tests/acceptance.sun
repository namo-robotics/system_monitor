/** Exercises native binaries, recordings, packaged resources, and HTTP hosting. */
using std;
using acceptance;

/** Runs the native acceptance suite. */
function main(argc: i32, argv: raw_ptr<raw_ptr<u8>>) i32 {
  return acceptance.entry(argc, argv);
}

/** Owns helpers and process-level acceptance cases. */
public module acceptance {

  using std;

  /** Carries application and assertion failures from test helpers. */
  public enum MonitorTestResult<T> {
    Ok(T),
    Error(Error),
    OutOfBounds(IndexOutOfBoundsError),
    NotFound(NotFoundError),
    Empty(EmptyError),
    InvalidArgument(InvalidArgumentError),
    Io(IOError),
    Allocation(AllocationError),
    Conversion(ConversionError),
    DivisionByZero(DivisionByZeroError),
    Overflow(OverflowError),
    Arithmetic(ArithmeticError),
    Json(JsonError),
    Xml(XmlError),
    Decode(ProtoDecodeError),
    Assertion(std.test.AssertionError)
  }

  /** Copies a checked buffer value before its storage is reused. */
  function buffer_value<T: _Primitive>(
    buffer: const ref ContiguousBuffer<T>,
    index: i64
  ) AccessResult<T> {
    var value: T = try buffer.get(index);
    return AccessResult.Ok(value);
  }

  /** Borrows fixture text without reserving mutable access. */
  function vector_read<T>(values: const ref Vec<T>, index: i64) AccessResult<const ref T> {
    return AccessResult.Ok(try values.get(index));
  }

  /** Checks readiness without retaining a borrow of the publication. */
  function publication_ready(view: ref Json, finished: bool) MonitorTestResult<bool> {
    var present = match view.get("snapshot") {
      JsonResult.Ok(snapshot) => not snapshot.is_null(),
      JsonResult.Error(error) => {
        return MonitorTestResult.Json(error);
      }
    };
    if (not present) {
      return MonitorTestResult.Ok(false);
    }
    if (finished) {
      return MonitorTestResult.Ok(try (try (try view.get("status")).get("finished")).as_bool());
    }
    return MonitorTestResult.Ok(
      (try (try (try view.get("snapshot")).get("elapsed_ms")).as_i64()) >= 500
    );
  }

  /** Sets a hostile display label and copies its process identity for replay checks. */
  function label_fixture(a: ref HeapAllocator, snapshot: ref Json) MonitorTestResult<String> {
    var row: ref Json = try (try snapshot.get("processes")).at(0);
    var identity = (try (try row.get("id")).as_string()).clone(a);
    try row.set(String("label"), Json(String("<img src=x onerror=alert(1)>")));
    return MonitorTestResult.Ok(identity);
  }

  /** Serializes a field and releases its borrow before the parent is reused. */
  function field_text(
    a: ref HeapAllocator,
    value: ref Json,
    key: static_ptr<u8>
  ) MonitorTestResult<String> {
    return MonitorTestResult.Ok((try value.get(key)).to_string(a));
  }

  /** Serializes the first process without retaining a borrow of its snapshot. */
  function first_process_text(a: ref HeapAllocator, snapshot: ref Json) MonitorTestResult<String> {
    var row: ref Json = try (try snapshot.get("processes")).at(0);
    return MonitorTestResult.Ok(row.to_string(a));
  }

  /** Compares a row's identity without retaining a borrow of the row. */
  function same_identity(row: ref Json, identity: const ref String) MonitorTestResult<bool> {
    return MonitorTestResult.Ok((try (try row.get("id")).as_string()).equals(identity));
  }

  /** Copies all rows except the chosen identity to exercise replayed process exits. */
  function remaining_processes(
    a: ref HeapAllocator,
    snapshot: ref Json,
    identity: const ref String
  ) MonitorTestResult<Json> {
    var remaining = create_json_array(a);
    var rows: ref Json = try snapshot.get("processes");
    for (var i: i64 = 0; i < rows.len(); i = i + 1) {
      var row: ref Json = try rows.at(i);
      if (not (try same_identity(row, identity))) {
        try remaining.push(try parse_json(a, row.to_string(a)));
      }
    }
    return MonitorTestResult.Ok(remaining);
  }

  var harness: String = String("");
  /** Bounds child execution even if the application stops responding. */
  extern "C" function alarm(seconds: u32) u32;

  /** Runs native checks and propagates failures to the command boundary. */
  function run_checks(
    a: ref HeapAllocator,
    argc: i32,
    argv: raw_ptr<raw_ptr<u8>>
  ) MonitorTestResult<i32> {
    if (argc > 1) {
      var arg = from_c_str(a, unsafe { _load<raw_ptr<u8>>(argv, 1); });
      if (arg.equals_literal("--exec") and argc > 2) {
        var program = from_c_str(a, unsafe { _load<raw_ptr<u8>>(argv, 2); });
        var cmd = std.process.Command(a, program);
        for (var i: i64 = 3; i < _convert<i64>(argc); i = i + 1) {
          cmd.add_arg(from_c_str(a, unsafe { _load<raw_ptr<u8>>(argv, i); }));
        }
        unsafe { alarm(15u32); };
        try std.process.exec(cmd);
        return MonitorTestResult.Ok(127);
      }
      if (arg.equals_literal("--workload")) {
        /** Leave headroom for the kernel's approximate resident-page counters. */
        var data = ContiguousBuffer<u8>(a, 41943040);
        data.fill(1u8);
        while (true) {
          for (var i: i64 = 0; i < data.size(); i = i + 4096) {
            try data.set(i, (try buffer_value(data, i)) + 1u8);
          }
        }
      }
    }
    var env = std.env.Env(a);
    var binary = String("build/system_monitor");
    var html = String("assets/dashboard.html");
    match env.get("PM_BIN") {
      Option.Some(value) => {
        binary = value.clone(a);
        binary.append("");
      },
      Option.None => {}
    };
    match env.get("PM_DASHBOARD") {
      Option.Some(value) => {
        html = value.clone(a);
        html.append("");
      },
      Option.None => {}
    };
    var temp = try Temp(a);
    if (argc == 1) {
      try invalid_options(a, binary);
      try resource_views(a, binary);
      try terminal_tabs(a, binary);
      try recording(a, binary, temp.path);
      try terminal(a, binary, temp.path, false, false);
      try terminal(a, binary, temp.path, true, false);
    }
    try web(a, binary, html, temp.path);
    println("PASS native acceptance: CLI, recordings, terminal, package resources, HTTP");
    return MonitorTestResult.Ok(0);
  }

  /** Runs acceptance checks or supplies their CPU and memory workload. */
  public function entry(argc: i32, argv: raw_ptr<raw_ptr<u8>>) i32 {
    var a = make_heap_allocator();
    harness = from_c_str(a, unsafe { _load<raw_ptr<u8>>(argv, 0); });
    match run_checks(a, argc, argv) {
      MonitorTestResult.Ok(value) => {
        return value;
      },
      (e: const ref ArithmeticError) => {
        eprintln(e.message());
        return 1;
      },
      (e: const ref IError) => {
        eprintln(e.message());
        return 1;
      }
    };
  }

  /** Checks direct views and rejects conflicting process-only options. */
  function resource_views(a: ref HeapAllocator, binary: ref String) MonitorTestResult<void> {
    var names = String("disk service network temperature");
    var views = names.split_whitespace(a);
    for (var i: i64 = 0; i < views.size(); i = i + 1) {
      var args = String("--monitor ");
      args.append(try vector_read(views, i));
      args.append(" --samples 2 --interval .1");
      var result = try run(a, binary, args, 0);
      var title = String("SYSTEM MONITOR / ");
      title.append(try vector_read(views, i));
      try check(result.stdout().contains(title), "resource view title missing");
      try check(result.stdout().contains("sample 2"), "resource sample limit missing");
      try check(
        not result.stdout().contains("\x1b"),
        "redirected resource view has ANSI escapes"
      );
    }
    try run(a, binary, String("--monitor invalid"), 1);
    try run(a, binary, String("--monitor disk --record unused.jsonl"), 1);
    try run(a, binary, String("--monitor network --replay absent.jsonl"), 1);

    return MonitorTestResult.Ok;
  }

  /** Creates a unique temporary directory. */
  extern "C" function mkdtemp(path: raw_ptr<u8>) raw_ptr<u8>;

  /** Sends a signal to a child during cleanup. */
  extern "C" function kill(pid: i32, signal: i32) i32;

  /** Reaps a child during cleanup. */
  extern "C" function waitpid(pid: i32, status: raw_ptr<i32>, options: i32) i32;

  /** Checks an invariant with an explanatory failure. */
  function check(value: bool, message: static_ptr<u8>) MonitorTestResult<void> {
    try std.test.assert(value, message);

    return MonitorTestResult.Ok;
  }

  /** Sleeps without spinning while a child does work. */
  function sleep(ms: i64) void {
    std.time.sleep(std.time.create_duration_millis(ms));
  }

  /** Builds arguments from test literals without invoking a shell. */
  function command(
    a: ref HeapAllocator,
    binary: const ref String,
    args: const ref String
  ) MonitorTestResult<std.process.Command> {
    var cmd = std.process.Command(a, binary);
    var parts = args.split(a, b' ');
    for (var i: i64 = 0; i < parts.size(); i = i + 1) {
      if (not (try vector_read(parts, i)).is_empty()) {
        cmd.add_arg(try vector_read(parts, i));
      }
    }
    return MonitorTestResult.Ok(cmd);
  }

  /** Captures a command and checks its status. */
  function run(
    a: ref HeapAllocator,
    binary: const ref String,
    args: String,
    code: i32
  ) MonitorTestResult<std.process.Output> {
    var cmd = std.process.Command(a, harness);
    cmd.add_arg("--exec");
    cmd.add_arg(binary);
    var parts = args.split(a, b' ');
    for (var i: i64 = 0; i < parts.size(); i = i + 1) {
      if (not (try vector_read(parts, i)).is_empty()) {
        cmd.add_arg(try vector_read(parts, i));
      }
    }
    var result = try cmd.output();
    if ((result.status()) != code) {
      eprintln(args);
      eprintln(result.stderr());
    }
    try check((result.status()) == code, "unexpected command status");
    return MonitorTestResult.Ok(result);
  }

  /** Removes temporary recordings even when a check fails. */
  class Temp {
    var path: String;

    /** Creates an isolated directory for recordings and fixture files. */
    init(a: ref HeapAllocator) MonitorTestResult<void> {
      this.path = String("/tmp/process-monitor-test-XXXXXX");
      try check(unsafe { mkdtemp(this.path.c_str()); } != null, "mkdtemp failed");

      return MonitorTestResult.Ok;
    }

    /** Removes fixture files after success or failure. */
    deinit() {
      var a = make_heap_allocator();
      var cmd = std.process.Command(a, "rm");
      cmd.add_arg("-rf");
      cmd.add_arg(this.path);
      ignore_error(cmd.status());
    }
  }

  /** Owns a child and prevents failed assertions from leaving it running. */
  class Running {
    var child: std.process.Child;

    /** Starts a child process whose lifetime belongs to this fixture. */
    init(cmd: ref std.process.Command) MonitorTestResult<void> {
      this.child = try cmd.start();

      return MonitorTestResult.Ok;
    }

    /** Terminates and reaps a child that has not been stopped. */
    deinit() {
      var pid = this.child.id();
      if (pid > 0) {
        unsafe { (kill(pid, 9)); waitpid(pid, null, 0); };
      }
    }

    /** Requires graceful shutdown within a bounded interval. */
    method stop() MonitorTestResult<void> {
      try this.child.kill(15);
      for (var i: i64 = 0; i < 160; i = i + 1) {
        match try this.child.try_wait() {
          Option.Some(code) => {
            try check(code == 0, "child did not shut down cleanly");
            return MonitorTestResult.Ok;
          },
          Option.None => {}
        };
        sleep(50);
      }
      return MonitorTestResult.Error(Error(1, "child shutdown timed out"));

      return MonitorTestResult.Ok;
    }
  }

  /** Rejects malformed options and checks informational commands. */
  function invalid_options(a: ref HeapAllocator, binary: ref String) MonitorTestResult<void> {
    var cases = String(
      "--top 0|--sort network|--interval nan|--interval 0|--history -2|--memory-limit 0|--samples -1|--top|--ui invalid|--unknown x|--record x --replay y"
    ).split(
      a,
      b'|'
    );
    for (var i: i64 = 0; i < cases.size(); i = i + 1) {
      try run(a, binary, (try cases.get(i)).clone(a), 1);
    }
    var help = try run(a, binary, String("--help"), 0);
    try check(help.stdout().contains("Usage:"), "help output");
    var version = try run(a, binary, String("--version"), 0);
    try check(version.stdout().starts_with("system_monitor "), "version output");

    return MonitorTestResult.Ok;
  }

  /** Checks collection under load, replay, overwrite refusal, and corrupt input. */
  function recording(
    a: ref HeapAllocator,
    binary: ref String,
    directory: ref String
  ) MonitorTestResult<void> {
    var cmd = std.process.Command(a, "build/acceptance");
    cmd.add_arg("--workload");
    cmd.set_stdout(std.process.Stdio.Null);
    var worker = try Running(cmd);
    sleep(150);
    var path = directory.clone(a);
    path.append("/session.jsonl");
    var args = String("--samples 4 --interval .15 --top 1 --record ");
    args.append(path);
    var result = try run(a, binary, args, 0);
    try check(not result.stdout().contains("\x1b"), "redirected output contains styling");
    var text = try std.io.read_to_string(a, path);
    var lines = text.split(a, b'\n');
    try check(lines.size() == 6, "recording frame count");
    var header = try parse_json(a, try lines.get(0));
    try check(
      (try (try header.get("type")).as_string()).equals_literal("session"),
      "recording header"
    );
    var seen: bool = false;
    var busy: bool = false;
    for (var i: i64 = 1; i < 5; i = i + 1) {
      var frame = try parse_json(a, try lines.get(i));
      var rows: ref Json = try frame.get("processes");
      try check(rows.len() > 1, "top-N must not filter recordings");
      for (var j: i64 = 0; j < rows.len(); j = j + 1) {
        var row: ref Json = try rows.at(j);
        if ((try (try row.get("pid")).as_i64()) == _convert<i64>(worker.child.id())) {
          seen = true;
          try check((try (try row.get("rss")).as_i64()) >= 33554432, "workload memory missing");
          try check(not (try row.get("memory")).is_null(), "memory percentage missing");
          if (i == 1) {
            try check((try row.get("cpu")).is_null(), "first CPU sample must be unknown");
          }
          if (not (try row.get("cpu")).is_null() and (try (try row.get("cpu")).as_f64()) > 5.0) {
            busy = true;
          }
        }
      }
    }
    try check(seen and busy, "CPU workload missing from recordings");
    args = String("--replay ");
    args.append(path);
    args.append(" --interval .1");
    try run(a, binary, args, 0);
    args = String("--record ");
    args.append(path);
    args.append(" --samples 1");
    try run(a, binary, args, 1);
    var damaged = directory.clone(a);
    damaged.append("/damaged.jsonl");
    var incomplete = text.clone(a);
    incomplete.append("{\"version\":");
    try std.io.write_string(damaged, incomplete);
    args = String("--replay ");
    args.append(damaged);
    args.append(" --interval .1");
    try run(a, binary, args.clone(a), 0);
    text.append("broken\n");
    try std.io.write_string(damaged, text);
    try run(a, binary, args, 1);

    return MonitorTestResult.Ok;
  }

  /** Fetches one local HTTP response with a bounded network timeout. */
  function request(
    a: ref HeapAllocator,
    base: ref String,
    path: static_ptr<u8>,
    method: static_ptr<u8>,
    code: static_ptr<u8>
  ) MonitorTestResult<String> {
    return MonitorTestResult.Ok(try request_path(a, base, String(path), method, code));
  }

  /** Fetches an endpoint whose path includes a recorded identity. */
  function request_path(
    a: ref HeapAllocator,
    base: ref String,
    path: String,
    method: static_ptr<u8>,
    code: static_ptr<u8>
  ) MonitorTestResult<String> {
    var cmd = std.process.Command(a, "curl");
    cmd.add_arg("--silent");
    cmd.add_arg("--show-error");
    cmd.add_arg("--max-time");
    cmd.add_arg("5");
    cmd.add_arg("--write-out");
    cmd.add_arg("\n%{http_code}");
    if (String(method).equals_literal("HEAD")) {
      cmd.add_arg("--head");
    }
    cmd.add_arg("--request");
    cmd.add_arg(method);
    var url = base.clone(a);
    url.append(path);
    cmd.add_arg(url);
    var out = try cmd.output();
    try check((out.status()) == 0, "HTTP request failed");
    var body = out.stdout();
    try check(body.ends_with(code), "unexpected HTTP status");
    return MonitorTestResult.Ok(try body.substr(a, 0, body.length() - 4));
  }

  /** Reads a publication and reports whether the requested sampling state is ready. */
  function ready_view(
    a: ref HeapAllocator,
    base: ref String,
    finished: bool
  ) MonitorTestResult<Option<Json>> {
    var body = try request(a, base, "/api/v1/view", "GET", "200");
    var view = try parse_json(a, body);
    if (try publication_ready(view, finished)) {
      return MonitorTestResult.Ok(Option.Some(view));
    }

    return MonitorTestResult.Ok(Option.None);
  }

  /** Waits for a consistent publication, allowing server startup and sampling. */
  function wait_view(
    a: ref HeapAllocator,
    base: ref String,
    finished: bool
  ) MonitorTestResult<Json> {
    for (var i: i64 = 0; i < 100; i = i + 1) {
      match ready_view(a, base, finished) {
        MonitorTestResult.Ok(value) => {
          match value {
            Option.Some(view) => {
              return MonitorTestResult.Ok(view);
            },
            Option.None => {}
          };
        },
        (e: const ref ArithmeticError) => {},
        (e: const ref IError) => {}
      };
      sleep(50);
    }
    return MonitorTestResult.Error(Error(1, "server did not publish in time"));
  }

  /** Verifies the resource bytes, APIs, retention, bind failures, and replay. */
  function web(
    a: ref HeapAllocator,
    binary: ref String,
    html: ref String,
    directory: ref String
  ) MonitorTestResult<void> {
    var env = std.env.Env(a);
    var uname = try run(a, String("uname"), String("-m"), 0);
    var enabled: bool = _target_is("linux") and uname.stdout().starts_with("x86_64");
    match env.get("SUN_WEB") {
      Option.Some(value) => {
        if (value.equals_literal("0")) {
          enabled = false;
        }
      },
      Option.None => {}
    };
    if (not enabled) {
      try run(a, binary, String("--ui web"), 1);
      return MonitorTestResult.Ok;
    }
    var port = try free_port(a);
    var base = String("http://127.0.0.1:");
    base.append(port);
    var recording = directory.clone(a);
    recording.append("/web.jsonl");
    var args = String("--ui web --interval .1 --history .3 --top 1 --port ");
    args.append(port);
    args.append(" --record ");
    args.append(recording);
    var cmd = try command(a, binary, args);
    cmd.set_stdout(std.process.Stdio.Null);
    cmd.set_stderr(std.process.Stdio.Null);
    var server = try Running(cmd);
    var view = try wait_view(a, base, false);
    try check(
      try (try (try view.get("status")).get("evicted")).as_bool(),
      "history retention missing"
    );
    var resources_text = try request(a, base, "/api/v1/resources", "GET", "200");
    var resources = try parse_json(a, resources_text);
    var names = String("disk service network temperature").split_whitespace(a);
    try check(
      (try (try resources.get("timestamp_ms")).as_i64()) > 0,
      "resource timestamp missing"
    );
    var monitors: ref Json = try resources.get("monitors");
    for (var i: i64 = 0; i < names.size(); i = i + 1) {
      var key = (try names.get(i)).clone(a);
      var resource: ref Json = try monitors.get(key);
      try check((try resource.get("lines")).len() > 0, "web resource rows missing");
      try check((try (try resource.get("samples")).as_i64()) > 0, "web resource sample missing");
      try check((try resource.get("rows")).is_array(), "structured resource rows missing");
      try check(
        (try resource.get("message")).is_string(),
        "resource availability message missing"
      );
    }
    try request(a, base, "/api/v1/resources", "POST", "405");
    var actual = try request(a, base, "/", "GET", "200");
    var expected = try std.io.read_to_string(a, html);
    try check(actual.equals(expected), "server did not serve packaged HTML");
    var headers = try request(a, base, "/", "HEAD", "200");
    try check(not headers.contains("<canvas"), "HEAD returned an HTML body");
    try request(a, base, "/api/v1/snapshot", "POST", "405");
    try request(a, base, "/absent", "GET", "404");
    try request(a, base, "/api/v1/history?id=bad", "GET", "400");
    var occupied = try BoundPort(a);
    var duplicate = String("--ui web --port ");
    duplicate.append(occupied.port);
    try run(a, binary, duplicate, 1);
    var clients = Vec<Running>(a, 18);
    for (var i: i64 = 0; i < 18; i = i + 1) {
      var client = std.process.Command(a, "curl");
      client.add_arg("--fail");
      client.add_arg("--silent");
      client.add_arg("--max-time");
      client.add_arg("5");
      var url = base.clone(a);
      url.append("/api/v1/view");
      client.add_arg(url);
      client.set_stdout(std.process.Stdio.Piped);
      client.set_stderr(std.process.Stdio.Null);
      clients.push(try Running(client));
    }
    for (var i: i64 = 0; i < clients.size(); i = i + 1) {
      var response = try (try clients.get(i)).child.collect(a);
      try check((response.status()) == 0, "concurrent HTTP request failed");
      var current = try parse_json(a, response.stdout());
      var snapshot = try field_text(a, current, "snapshot");
      var frames: ref Json = try current.get("history");
      try check(
        (try frames.at(frames.len() - 1)).to_string(a).equals(
          snapshot
        ),
        "inconsistent publication"
      );
    }
    try server.stop();
    var recorded = try std.io.read_to_string(a, recording);
    try check(
      recorded.contains((try view.get("snapshot")).to_string(a)),
      "web and recording differ"
    );
    var lines = recorded.split(a, b'\n');
    var first = try parse_json(a, try lines.get(1));
    var second = try parse_json(a, try lines.get(2));
    var identity = try label_fixture(a, first);
    var remaining = try remaining_processes(a, second, identity);
    try second.set(String("processes"), remaining);
    var replay_text = (try lines.get(0)).clone(a);
    replay_text.append("\n");
    replay_text.append(first.to_string(a));
    replay_text.append("\n");
    replay_text.append(second.to_string(a));
    replay_text.append("\n");
    try std.io.write_string(recording, replay_text);
    args = String("--ui web --interval .1 --port ");
    args.append(port);
    args.append(" --replay ");
    args.append(recording);
    cmd = try command(a, binary, args);
    cmd.set_stdout(std.process.Stdio.Null);
    cmd.set_stderr(std.process.Stdio.Null);
    var replay = try Running(cmd);
    view = try wait_view(a, base, true);
    try check(
      try (try (try view.get("status")).get("replay")).as_bool(),
      "replay status missing"
    );
    try check(
      (try view.get("snapshot")).to_string(a).equals(second.to_string(a)),
      "replay snapshot mismatch"
    );
    try check((try view.get("history")).len() == 2, "replay history mismatch");
    var identity_path = String("/api/v1/history?id=");
    identity_path.append(identity);
    var history_text = try request_path(a, base, identity_path, "GET", "200");
    var points = try parse_json(a, history_text);
    try check(
      (try (try points.at(0)).get("process")).to_string(a).equals(
        try first_process_text(a, first)
      ),
      "identity history mismatch"
    );
    try check(
      (try (try points.at(1)).get("process")).is_null(),
      "exited identity must leave a gap"
    );
    var snapshot = try request(a, base, "/api/v1/snapshot", "GET", "200");
    try check(snapshot.equals(second.to_string(a)), "snapshot endpoint mismatch");
    var live_before = try parse_json(
      a,
      try request(a, base, "/api/v1/resources", "GET", "200")
    );
    sleep(1200);
    var live_after = try parse_json(a, try request(a, base, "/api/v1/resources", "GET", "200"));
    try check(
      (try (try live_after.get("timestamp_ms")).as_i64()) >
        (try (try live_before.get("timestamp_ms")).as_i64()),
      "replay completion stopped resource publication"
    );
    try replay.stop();
    var direct = String("--monitor network --ui web --samples 1 --port ");
    direct.append(port);
    var direct_result = try run(a, binary, direct, 0);
    try check(direct_result.stdout().is_empty(), "resource web mode printed terminal output");
    try terminal(a, binary, directory, false, true);
    try terminal(a, binary, directory, true, true);

    return MonitorTestResult.Ok;
  }
}

manifest {
  source_files: [
    "acceptance-pty.sun"
  ]
  libraries: [
    "stdlib.moon"
  ]
}
