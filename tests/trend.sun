/** Behavioral tests for identity-aware ranking and time-scaled dot graphs. */
public module system_monitor {

  using std;

  /** Builds a fixture with opposite CPU and memory rankings. */
  function trend_fixture(a: const ref HeapAllocator) std.AllocationResult<Frame> {
    var frame = Frame(a);
    for (var pid: i64 = 1; pid <= 7; pid = pid + 1) {
      var process = Process();
      process.pid = pid;
      process.start = 10;
      process.cpu = _convert<f64>(pid);
      process.rss = (8 - pid) * 1048576;
      process.label = try String("worker");
      try frame.processes.push(process);
    }
    return std.AllocationResult.Ok(frame);
  }

  /** Uses the selected resource to choose exactly the current highest consumers. */
  test_function trend_selects_top_five_by_resource() MonitorTestResult<void> {
    var a = make_heap_allocator();
    var frame = try trend_fixture(a);
    var graph = try TrendGraph(a);
    try graph.select(a, frame, false);
    try std.test.assert_eq(graph.series.size(), 5i64);
    try std.test.assert_eq((try vector_read(graph.series, 0)).pid, 7i64);
    try std.test.assert_eq((try vector_read(graph.series, 4)).pid, 3i64);
    try graph.select(a, frame, true);
    try std.test.assert_eq((try vector_read(graph.series, 0)).pid, 1i64);
    try std.test.assert_eq((try vector_read(graph.series, 4)).pid, 5i64);

    return MonitorTestResult.Ok;
  }

  /** Keeps a process's color through ranking changes and assigns distinct slots. */
  test_function trend_colors_follow_identity() MonitorTestResult<void> {
    var a = make_heap_allocator();
    var frame = try trend_fixture(a);
    var graph = try TrendGraph(a);
    try graph.select(a, frame, false);
    var color = match vector_read(graph.series, 0) {
      AccessResult.Ok(series) => series.color,
      AccessResult.OutOfBounds(error) => {
        return MonitorTestResult.OutOfBounds(error);
      }
    };
    var selected_process = try frame.processes.get(6);
    selected_process.cpu = 5.5;
    try graph.select(a, frame, false);
    try std.test.assert_eq((try vector_read(graph.series, 1)).pid, 7i64);
    try std.test.assert_eq((try vector_read(graph.series, 1)).color, color);
    try graph.select(a, frame, true);
    for (var i: i64 = 0; i < graph.series.size(); i = i + 1) {
      for (var j = i + 1; j < graph.series.size(); j = j + 1) {
        try std.test.assert(
          (try vector_read(graph.series, i)).color != (try vector_read(graph.series, j)).color,
          "unique colors"
        );
      }
    }

    return MonitorTestResult.Ok;
  }

  /** Places irregular samples according to time, not their array positions. */
  test_function trend_uses_elapsed_time_coordinates() MonitorTestResult<void> {
    try std.test.assert_eq(time_pixel(100, 0, 1000, 101), 10i64);
    try std.test.assert_eq(time_pixel(900, 0, 1000, 101), 90i64);
    try std.test.assert_eq(time_pixel(1000, 1000, 1000, 101), 100i64);

    return MonitorTestResult.Ok;
  }

  /** Encodes plotted dots without the old magnitude-character alphabet. */
  test_function canvas_encodes_dot_coordinates() MonitorTestResult<void> {
    var a = make_heap_allocator();
    var canvas = try DotCanvas(a, 1, 1);
    try canvas.point(0, 0, 0);
    try canvas.point(1, 3, 0);
    var out = try String("");
    try canvas.render_row(out, 0, false);
    try std.test.assert(out.equals_literal("⢁"), "Braille corner dots");

    return MonitorTestResult.Ok;
  }

  /** Breaks traces at unavailable samples instead of joining across gaps. */
  test_function trend_does_not_connect_missing_samples() MonitorTestResult<void> {
    var a = make_heap_allocator();
    var history = try History(a);
    for (var i: i64 = 0; i < 3; i = i + 1) {
      var frame = Frame(a);
      frame.elapsed = i * 1000;
      var p = Process();
      p.pid = 7;
      p.start = 10;
      p.cpu = 50.0;
      if (i != 1) {
        try frame.processes.push(p);
      }
      try history.add(frame);
    }
    var p = Process();
    p.pid = 7;
    p.start = 10;
    var item = try TrendSeries(a, p);
    item.color = 0;
    var graph = try TrendGraph(a);
    graph.duration = 2000;
    var canvas = try DotCanvas(a, 20, 3);
    try graph.trace(canvas, history, item, false, 100.0);
    try std.test.assert_eq(try canvas.masks.get(1 * 20 + 10), 0i64);
    var replacement = try TrendSeries(a, p);
    replacement.start = 11;
    replacement.color = 1;
    var empty = try DotCanvas(a, 20, 3);
    try graph.trace(empty, history, replacement, false, 100.0);
    for (var i: i64 = 0; i < 60; i = i + 1) {
      try std.test.assert_eq(try empty.masks.get(i), 0i64);
    }

    return MonitorTestResult.Ok;
  }

  /** Grows across a fixed span, then scrolls without resetting after eviction. */
  test_function trend_window_grows_then_scrolls() MonitorTestResult<void> {
    var a = make_heap_allocator();
    var history = try History(a);
    history.duration = 1000;
    var graph = try TrendGraph(a);
    var first = Frame(a);
    first.elapsed = 5000;
    try history.add(first);
    try std.test.assert_eq((graph.begin(history)), 5000i64);
    try std.test.assert_eq(
      time_pixel(
        5000,
        (graph.begin(history)),
        (graph.begin(history)) + graph.duration,
        121
      ),
      0i64
    );
    var middle = Frame(a);
    middle.elapsed = 35000;
    try history.add(middle);
    try std.test.assert_eq(history.frames.size(), 1i64);
    try std.test.assert_eq((graph.begin(history)), 5000i64);
    try std.test.assert_eq(
      time_pixel(
        35000,
        (graph.begin(history)),
        (graph.begin(history)) + graph.duration,
        121
      ),
      60i64
    );
    var full = Frame(a);
    full.elapsed = 65000;
    try history.add(full);
    try std.test.assert_eq((graph.begin(history)), 5000i64);
    var later = Frame(a);
    later.elapsed = 75000;
    try history.add(later);
    try std.test.assert_eq((graph.begin(history)), 15000i64);
    try std.test.assert_eq(
      time_pixel(
        75000,
        (graph.begin(history)),
        (graph.begin(history)) + graph.duration,
        121
      ),
      120i64
    );

    return MonitorTestResult.Ok;
  }

  /** Leaves future columns blank and excludes peaks outside the visible span. */
  test_function trend_raster_respects_fixed_window() MonitorTestResult<void> {
    var a = make_heap_allocator();
    var history = try History(a);
    var graph = try TrendGraph(a);
    for (var i: i64 = 0; i < 2; i = i + 1) {
      var frame = try trend_fixture(a);
      frame.elapsed = i * 30000;
      try graph.select(a, frame, false);
      try history.add(frame);
    }
    var canvas = try DotCanvas(a, 61, 1);
    try graph.trace(canvas, history, try vector_read(graph.series, 0), false, 7.0);
    try std.test.assert(try canvas.masks.get(0) != 0, "first sample at left");
    try std.test.assert(try canvas.masks.get(30) != 0, "latest sample halfway across");
    for (var i: i64 = 31; i < 61; i = i + 1) {
      try std.test.assert_eq(try canvas.masks.get(i), 0i64);
    }
    match history.frames.get(0) {
      AccessResult.Ok(retained_frame) => {
        var process: ref Process = try retained_frame.processes.get(6);
        process.cpu = 999.0;
      },
      AccessResult.OutOfBounds(error) => {
        return MonitorTestResult.OutOfBounds(error);
      }
    };
    var later = try trend_fixture(a);
    later.elapsed = 90000;
    try history.add(later);
    try std.test.assert_eq(try graph.scale(history, false), 7.0);

    return MonitorTestResult.Ok;
  }

  /** Fills every dot below a sample and keeps shorter areas in front in either order. */
  test_function filled_columns_overlap_by_height() MonitorTestResult<void> {
    var a = make_heap_allocator();
    for (var order: i64 = 0; order < 2; order = order + 1) {
      var canvas = try DotCanvas(a, 2, 3);
      if (order == 0) {
        try canvas.column(0, 0, 0);
        try canvas.column(0, 8, 1);
      } else {
        try canvas.column(0, 8, 1);
        try canvas.column(0, 0, 0);
      }
      try std.test.assert_eq(try canvas.masks.get(0), 71i64);
      try std.test.assert_eq(try canvas.masks.get(2), 71i64);
      try std.test.assert_eq(try canvas.masks.get(4), 71i64);
      try std.test.assert_eq(try canvas.owners.get(0), 0i64);
      try std.test.assert_eq(try canvas.owners.get(4), 1i64);
      try canvas.column(2, 8, 0);
      try canvas.column(2, 0, 1);
      try std.test.assert_eq(try canvas.owners.get(1), 1i64);
      try std.test.assert_eq(try canvas.owners.get(5), 0i64);
    }

    return MonitorTestResult.Ok;
  }

  /** Handles split arrow sequences without treating their bytes as shortcuts. */
  test_function terminal_arrows_move_selection() MonitorTestResult<void> {
    var a = make_heap_allocator();
    var terminal = try Terminal(a, false);
    var options = Options();
    terminal.apply_key(27u8, options);
    terminal.apply_key(b'[', options);
    try std.test.assert_eq(terminal.selected_row, 0i64);
    terminal.apply_key(b'B', options);
    try std.test.assert_eq(terminal.selected_row, 1i64);
    terminal.apply_key(27u8, options);
    terminal.apply_key(b'O', options);
    terminal.apply_key(b'A', options);
    try std.test.assert_eq(terminal.selected_row, 0i64);
    terminal.move_selection(false);
    try std.test.assert_eq(terminal.selected_row, 0i64);
    terminal.apply_key(27u8, options);
    terminal.apply_key(b'[', options);
    terminal.apply_key(b'5', options);
    terminal.apply_key(b'~', options);
    try std.test.assert_eq(options.top, 10i64);
    terminal.apply_key(b'j', options);
    try std.test.assert_eq(terminal.selected_row, 0i64);

    return MonitorTestResult.Ok;
  }
}
