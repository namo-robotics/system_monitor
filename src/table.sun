/** Bounded terminal tables and panels with presentation kept separate from data. */
public module system_monitor {

  using std;

  /** Formats fixed-width cells and colored borders for one terminal frame. */
  class TableStyle {
    var width: i64;
    var colored: bool;

    /** Leaves a spare terminal column to avoid automatic line wrapping. */
    init(columns: i64, colored: bool) {
      this.width = columns - 1;
      this.colored = colored;
    }

    /** Returns content widths shared by table rules, headers, and rows. */
    method column(index: i64) i64 {
      if (index == 0) {
        return 9;
      }
      if (index == 1) {
        return this.width - 47;
      }
      if (index == 2) {
        return 7;
      }
      if (index == 3) {
        return 6;
      }
      if (index == 4) {
        return 9;
      }
      return 8;
    }

    /** Sets an ANSI style only for interactive output. */
    method color(out: ref String, code: static_ptr<u8>) std.AllocationResult<void> {
      if (this.colored) {
        try out.append(code);
      }

      return std.AllocationResult.Ok;
    }

    /** Writes a Unicode border in terminals and an ASCII equivalent in pipes. */
    method edge(
      out: ref String,
      glyph: static_ptr<u8>,
      ascii: static_ptr<u8>
    ) std.AllocationResult<void> {
      try this.color(out, "\x1b[0;36m");
      if (this.colored) {
        try out.append(glyph);
      } else {
        try out.append(ascii);
      }
      try this.color(out, "\x1b[0m");

      return std.AllocationResult.Ok;
    }

    /** Draws a top, middle, or bottom rule with optional column junctions. */
    method rule(out: ref String, position: i64, divided: bool) std.AllocationResult<void> {
      if (position == 0) {
        try this.edge(out, "╭", "+");
      } else if (position == 1) {
        try this.edge(out, "├", "+");
      } else {
        try this.edge(out, "╰", "+");
      }
      var count: i64 = 1;
      if (divided) {
        count = 5;
      }
      try this.color(out, "\x1b[36m");
      for (var col: i64 = 0; col < count; col = col + 1) {
        var size = this.width - 2;
        if (divided) {
          size = (this.column(col)) + 2;
        }
        for (var i: i64 = 0; i < size; i = i + 1) {
          if (this.colored) {
            try out.append("─");
          } else {
            try out.append("-");
          }
        }
        if (col + 1 < count) {
          if (position == 0) {
            try this.edge(out, "┬", "+");
          } else if (position == 1) {
            try this.edge(out, "┼", "+");
          } else {
            try this.edge(out, "┴", "+");
          }
          try this.color(out, "\x1b[36m");
        }
      }
      if (position == 0) {
        try this.edge(out, "╮", "+");
      } else if (position == 1) {
        try this.edge(out, "┤", "+");
      } else {
        try this.edge(out, "╯", "+");
      }
      try out.append("\r\n");

      return std.AllocationResult.Ok;
    }

    /** Clips and pads text before applying color, keeping ANSI bytes out of widths. */
    method cell(
      a: const ref HeapAllocator,
      out: ref String,
      text: const ref String,
      width: i64,
      right: bool,
      selected: bool
    ) Result<void> {
      var clean = try safe_text(a, text, width);
      if (text.length() > width and width > 0) {
        try clean.set_at(width - 1, b'~');
      }
      if (selected) {
        try this.color(out, "\x1b[1;97;44m");
      }
      try out.append(" ");
      if (right) {
        for (var i = clean.length(); i < width; i = i + 1) {
          try out.append(" ");
        }
      }
      try out.append(clean);
      if (not right) {
        for (var i = clean.length(); i < width; i = i + 1) {
          try out.append(" ");
        }
      }
      try out.append(" ");
      try this.color(out, "\x1b[0m");
      try this.edge(out, "│", "|");

      return Result.Ok;
    }

    /** Writes one bounded line inside a full-width history panel. */
    method panel_line(
      a: const ref HeapAllocator,
      out: ref String,
      text: const ref String,
      accent: bool
    ) Result<void> {
      try this.edge(out, "│", "|");
      if (accent) {
        try this.color(out, "\x1b[1;32m");
      }
      try this.cell(a, out, text, this.width - 4, false, false);
      try out.append("\r\n");

      return Result.Ok;
    }
  }
}
