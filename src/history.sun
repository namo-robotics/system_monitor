/* Bounded retention of display samples, including exited processes. */
public module system_monitor {

  using std;

  /* Retains complete frames within a duration and estimated memory budget. */
  class History {
    var frames: Vec<Frame>;
    var bytes: i64 = 0;
    var limit: i64 = 67108864;
    var duration: i64 = 600000;
    var evicted: bool = false;
    var origin: i64 = -1;
    var latest: i64 = 0;

    /* Initializes owned state and resources for this object. */
    init(alloc: const ref HeapAllocator) {
      this.frames = Vec<Frame>(alloc, 16);
    }

    /* Retains a sample and evicts the oldest frames when limits are exceeded. */
    method add(frame: Frame) Result<void> {
      var latest = frame.elapsed;
      if (this.origin < 0) {
        this.origin = latest;
      }
      this.latest = latest;
      var cost = (try frame.cost());
      while ((this.frames.size()) > 0) {
        var removed_cost: i64 = 0;
        match this.frames.get(0) {
          AccessResult.Ok(oldest) => {
          if (latest - oldest.elapsed <= this.duration and this.bytes + cost <= this.limit) {
            break;
          }
          removed_cost = try oldest.cost();
          },
          AccessResult.OutOfBounds(error) => { return Result.OutOfBounds(error); }
        };
        this.bytes = this.bytes - removed_cost;
        var removed = (try this.frames.remove(0));
        this.evicted = true;
      }
      // An oversized frame remains available to the current view, but is not retained.
      if (cost > this.limit) {
        this.evicted = true;
        return Result.Ok;
      }
      this.bytes = this.bytes + cost;
      this.frames.push(frame);

      return Result.Ok;
    }

    /* Returns the elapsed time covered by retained samples. */
    method window() Result<i64> {
      if ((this.frames.size()) < 2) {
        return Result.Ok(0);
      }
      var first = try vector_read(this.frames, 0);
      var last = try vector_read(this.frames, this.frames.size() - 1);
      return Result.Ok(last.elapsed - first.elapsed);
    }
  }
}
