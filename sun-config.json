{
  "root": true,
  "sun_path": [
    "build"
  ],
  "path_variables": {
    "MUSL_LIB": ".ci/musl/x86_64-linux-musl-cross/x86_64-linux-musl/lib"
  },
  "dependencies": {
    "SUN_SERVE": {
      "target": {
        "x86_64-linux-gnu": {
          "git": "https://github.com/namo-robotics/sun_serve.git",
          "version": "09cfe99ac12cd5de71a8a37b6f2f45aaedb98abd",
          "path": "src/sun_serve.sun"
        }
      }
    }
  },
  "entrypoints": [
    {
      "path": "build/main.sun",
      "type": "binary",
      "output_name": "build/system_monitor",
      "test_binary_name": "build/system_monitor_test",
      "name": "system_monitor"
    },
    {
      "path": "tests/acceptance.sun",
      "type": "binary",
      "output_name": "build/acceptance"
    }
  ],
  "packages": [
    {
      "name": "system_monitor",
      "entrypoints": [
        "system_monitor"
      ],
      "resources": [
        {
          "path": "assets/dashboard.html",
          "destination": "share/system_monitor/dashboard.html"
        }
      ]
    }
  ]
}
