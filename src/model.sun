/** Process samples, bounded history, and display-independent serialization. */
public module system_monitor {

  using std;

  /** Copies a checked buffer element without keeping its storage borrowed. */
  function buffer_value<T: _Primitive>(buffer: const ref ContiguousBuffer<T>, index: i64) T throws {
    var value: T = buffer.get(index);
    return value;
  }

  /** Copies a checked vector element without keeping its storage borrowed. */
  function vector_value<T: _Primitive>(values: const ref Vec<T>, index: i64) T throws {
    var value: T = values.get(index);
    return value;
  }

  /** Borrows a checked vector element for read-only access. */
  function vector_read<T>(values: const ref Vec<T>, index: i64) const ref T throws {
    return values.get(index);
  }

  /** Owns the identity, metadata, and measurements of one process. */
  class Process {
    var pid: i64 = 0;
    var start: i64 = 0;
    var ticks: i64 = -1;
    var rss: i64 = -1;
    var cpu: f64 = -1.0;
    var memory: f64 = -1.0;
    var exe: String;
    var args: String;
    var label: String;

    /** Formats a stable identity from the PID and process start marker. */
    method id() String throws {
      var s = String("");
      s.append(this.pid);
      s.append(":");
      s.append(this.start);
      return s;
    }

    /** Initializes owned storage and reports allocation failure. */
    init() throws {
      this.exe = String("");
      this.args = String("");
      this.label = String("");
    }
  }

  /** Owns all measurements from one sampling instant. */
  class Frame {
    var timestamp: i64 = 0;
    var elapsed: i64 = 0;
    var total_memory: i64 = 0;
    var inaccessible: i64 = 0;
    var processes: Vec<Process>;

    /** Initializes owned state and resources for this object. */
    init(alloc: const ref HeapAllocator) throws {
      this.processes = Vec<Process>(alloc, 64);
    }

    /** Copies display measurements while keeping raw baselines in the live frame. */
    method copy(a: const ref HeapAllocator) Frame throws {
      var out = Frame(a);
      out.timestamp = this.timestamp;
      out.elapsed = this.elapsed;
      out.total_memory = this.total_memory;
      out.inaccessible = this.inaccessible;
      for (var i: i64 = 0; i < (this.processes.size()); i = i + 1) {
        var p: ref Process = this.processes.get(i);
        var q = Process();
        q.pid = p.pid;
        q.start = p.start;
        q.rss = p.rss;
        q.cpu = p.cpu;
        q.memory = p.memory;
        q.exe = p.exe.clone(a);
        q.label = p.label.clone(a);
        out.processes.push(q);
      }
      return out;
    }

    /** Estimates owned storage conservatively for history budgeting. */
    method cost() i64 throws {
      var n: i64 = _sizeof<Frame>() + 128 + this.processes.capacity() * _sizeof<Process>();
      for (var i: i64 = 0; i < (this.processes.size()); i = i + 1) {
        var p: ref Process = this.processes.get(i);
        n = n + 384 + p.exe.capacity() + p.args.capacity() + p.label.capacity();
      }
      return n;
    }
  }
}
