/* Time-scaled filled dot plots for the current highest resource consumers. */
public module system_monitor {
  using std;

  /* Returns a distinct terminal color for each active graph series. */
  function trend_color(slot: i64) static_ptr<u8> {
    if (slot == 0) {
      return "\x1b[38;5;81m";
    }
    if (slot == 1) {
      return "\x1b[38;5;214m";
    }
    if (slot == 2) {
      return "\x1b[38;5;121m";
    }
    if (slot == 3) {
      return "\x1b[38;5;213m";
    }
    return "\x1b[38;5;227m";
  }

  /* Tracks identity and color without tying a series to its changing rank. */
  class TrendSeries {
    var pid: i64;
    var start: i64;
    var label: String;
    var color: i64 = -1;
    /* Copies the metadata needed to identify one plotted process. */
    init(a: const ref HeapAllocator, process: ref Process) {
      this.pid = process.pid;
      this.start = process.start;
      this.label = process.label.clone(a);
    }
  }

  /* Maps timestamps to horizontal dot positions using elapsed time. */
  function time_pixel(time: i64, begin: i64, end: i64, width: i64) i64 {
    if (end <= begin) {
      return width - 1;
    }
    return _convert<i64>(_convert<f64>(time - begin) * _convert<f64>(width - 1) / _convert<f64>(end - begin));
  }

  /* Stores filled dot areas, with shorter columns in front at each time position. */
  class DotCanvas {
    var width: i64;
    var height: i64;
    var masks: ContiguousBuffer<i64>;
    var owners: ContiguousBuffer<i64>;
    var depths: ContiguousBuffer<i64>;
    /* Allocates a character grid with finer dot coordinates inside each cell. */
    init(a: const ref HeapAllocator, width: i64, height: i64) {
      this.width = width;
      this.height = height;
      this.masks = ContiguousBuffer<i64>(a, width * height);
      this.owners = ContiguousBuffer<i64>(a, width * height);
      this.depths = ContiguousBuffer<i64>(a, width * height);
      this.depths.fill(-1);
      this.masks.fill(0);
      this.owners.fill(-1);
    }

    /* Plots one dot, rejecting coordinates outside the canvas. */
    method point(x: i64, y: i64, owner: i64) void throws IError {
      if (x < 0 or y < 0 or x >= this.width * 2 or y >= this.height * 4) {
        return;
      }
      var index = (y / 4) * this.width + x / 2;
      var bit: i64 = 1;
      if (y % 4 == 1) {
        bit = 2;
      }
      if (y % 4 == 2) {
        bit = 4;
      }
      if (y % 4 == 3) {
        bit = 64;
      }
      if (x % 2 == 1) {
        bit = bit * 8;
        if (y % 4 == 3) {
          bit = 128;
        }
      }
      this.masks.set(index, this.masks.get(index) | bit);
      this.owners.set(index, owner);
    }

    /* Fills to the baseline, giving shorter areas the color of overlapping cells. */
    method column(x: i64, top: i64, owner: i64) void throws IError {
      if (x < 0 or x >= this.width * 2 or top < 0 or top >= this.height * 4) {
        return;
      }
      for (var y = top; y < this.height * 4; y = y + 1) {
        var index = (y / 4) * this.width + x / 2;
        var foreground: i64 = this.owners.get(index);
        if (top >= this.depths.get(index)) {
          this.depths.set(index, top);
          foreground = owner;
        }
        this.point(x, y, foreground);
      }
    }

    /* Interpolates the filled area between consecutive available samples. */
    method line(x0: i64, y0: i64, x1: i64, y1: i64, owner: i64) void throws IError {
      var dx = x1 - x0;
      var dy = y1 - y0;
      var steps = dx;
      var vertical = dy;
      if (vertical < 0) {
        vertical = -vertical;
      }
      if (vertical > steps) {
        steps = vertical;
      }
      if (steps < 1) {
        this.column(x1, y1, owner);
        return;
      }
      for (var i: i64 = 0; i <= steps; i = i + 1) {
        this.column(x0 + dx * i / steps, y0 + dy * i / steps, owner);
      }
    }

    /* Emits a row of colored Braille dots rather than magnitude symbols. */
    method render_row(out: ref String, row: i64, colored: bool) void throws IError {
      for (var col: i64 = 0; col < this.width; col = col + 1) {
        var index = row * this.width + col;
        var mask: i64 = this.masks.get(index);
        if (mask == 0) {
          out.append(" ");
          continue;
        }
        if (colored) {
          out.append(trend_color(this.owners.get(index)));
        }
        out.append_char(226u8);
        out.append_char(_convert<u8>(160 + mask / 64));
        out.append_char(_convert<u8>(128 + mask % 64));
      }
      if (colored) {
        out.append("\x1b[0m");
      }
    }
  }

  /* Owns the active top-five identities and renders their shared history plot. */
  class TrendGraph {
    var series: Vec<TrendSeries>;
    var duration: i64 = 60000;
    /* Starts with no assigned colors or process identities. */
    init(a: const ref HeapAllocator) {
      this.series = Vec<TrendSeries>(a, 5);
    }

    /* Chooses current leaders independently of the table's display limit. */
    method select(a: const ref HeapAllocator, frame: ref Frame, memory: bool) void throws IError {
      var order = ranking(a, frame, memory);
      var next = Vec<TrendSeries>(a, 5);
      for (var i: i64 = 0; i < order.size() and next.size() < 5; i = i + 1) {
        var process: ref Process = frame.processes.get(order.get(i));
        if ((memory and process.rss < 0) or (not memory and process.cpu < 0.0)) {
          continue;
        }
        var item = TrendSeries(a, process);
        for (var old: i64 = 0; old < this.series.size(); old = old + 1) {
          var prior: ref TrendSeries = this.series.get(old);
          if (prior.pid == item.pid and prior.start == item.start) {
            item.color = prior.color;
            break;
          }
        }
        next.push(item);
      }
      this.assign_colors(next);
      this.series = next;
    }

    /* Preserves existing colors and gives new identities unused palette slots. */
    method assign_colors(next: ref Vec<TrendSeries>) void throws IError {
      for (var i: i64 = 0; i < next.size(); i = i + 1) {
        if (next.get(i).color >= 0) {
          continue;
        }
        for (var slot: i64 = 0; slot < 5; slot = slot + 1) {
          var used = false;
          for (var k: i64 = 0; k < next.size(); k = k + 1) {
            if (next.get(k).color == slot) {
              used = true;
            }
          }
          if (not used) {
            next.get(i).color = slot;
            break;
          }
        }
      }
    }

    /* Anchors startup at the first sample, then advances the fixed time window. */
    method begin(history: ref History) i64 {
      var start = history.latest - this.duration;
      if (start < history.origin) {
        start = history.origin;
      }
      return start;
    }

    /* Finds one common resource scale across all displayed histories. */
    method scale(history: ref History, memory: bool) f64 throws IError {
      var peak: f64 = 1.0;
      var begin = this.begin(history);
      for (var f: i64 = 0; f < history.frames.size(); f = f + 1) {
        if (history.frames.get(f).elapsed < begin) {
          continue;
        }
        for (var i: i64 = 0; i < this.series.size(); i = i + 1) {
          var item: ref TrendSeries = this.series.get(i);
          var value = history_value(history.frames.get(f), item.pid, item.start, memory);
          if (value > peak) {
            peak = value;
          }
        }
      }
      return peak;
    }

    /* Draws a process history while breaking the line at missing samples. */
    method trace(canvas: ref DotCanvas, history: ref History, item: ref TrendSeries, memory: bool, peak: f64) void throws IError {
      if (history.frames.is_empty()) {
        return;
      }
      var begin = this.begin(history);
      var end = begin + this.duration;
      var connected = false;
      var previous_x: i64 = 0;
      var previous_y: i64 = 0;
      for (var i: i64 = 0; i < history.frames.size(); i = i + 1) {
        var frame: ref Frame = history.frames.get(i);
        if (frame.elapsed < begin) {
          continue;
        }
        var value = history_value(frame, item.pid, item.start, memory);
        if (value < 0.0) {
          connected = false;
          continue;
        }
        var x = time_pixel(frame.elapsed, begin, end, canvas.width * 2);
        var y = canvas.height * 4 - 1 - _convert<i64>(value / peak * _convert<f64>(canvas.height * 4 - 1));
        if (connected) {
          canvas.line(previous_x, previous_y, x, y, item.color);
        } else {
          canvas.column(x, y, item.color);
        }
        previous_x = x;
        previous_y = y;
        connected = true;
      }
    }

    /* Writes an axis label and a raster row inside the bordered panel. */
    method plot_row(a: const ref HeapAllocator, out: ref String, style: ref TableStyle, canvas: ref DotCanvas, row: i64, peak: f64) void throws IError {
      var label = String("");
      if (row == 0) {
        label = decimal(peak);
      } else if (row == canvas.height - 1) {
        label = String("0");
      }
      style.edge(out, "│", "|");
      out.append(" ");
      out.append(padded(safe_text(a, label, 8), 8));
      out.append(" ");
      canvas.render_row(out, row, style.colored);
      out.append(" ");
      style.edge(out, "│", "|");
      out.append("\r\n");
    }

    /* Identifies every line with matching colors, process names, and PIDs. */
    method legend(a: const ref HeapAllocator, out: ref String, style: ref TableStyle) void throws IError {
      for (var row: i64 = 0; row < 2; row = row + 1) {
        style.edge(out, "│", "|");
        var width = (style.width - 2) / 3;
        for (var col: i64 = 0; col < 3; col = col + 1) {
          var index = row * 3 + col;
          var text = String("");
          if (index < this.series.size()) {
            var item: ref TrendSeries = this.series.get(index);
            text.append(item.pid);
            text.append(" ");
            text.append(item.label);
            style.color(out, trend_color(item.color));
          }
          var cell_width = width;
          if (col == 2) {
            cell_width = style.width - 2 - width * 2;
          }
          out.append(padded(safe_text(a, text, cell_width), cell_width));
          style.color(out, "\x1b[0m");
        }
        style.edge(out, "│", "|");
        out.append("\r\n");
      }
    }

    /* Displays the resource selector with only the active choice in bold. */
    method header(a: const ref HeapAllocator, out: ref String, style: ref TableStyle, memory: bool) void throws IError {
      var title = String("TOP 5 CPU HISTORY (%)  |  ");
      if (memory) {
        title = String("TOP 5 MEMORY HISTORY (RSS MiB)  |  ");
      }
      var selected = title.length();
      if (memory) {
        selected = selected + 6;
      }
      title.append("CPU / MEM");
      if (this.series.is_empty()) {
        title.append("  |  waiting");
      }
      var text = padded(safe_text(a, title, style.width - 4), style.width - 4);
      style.edge(out, "│", "|");
      out.append(" ");
      for (var i: i64 = 0; i < text.length(); i = i + 1) {
        if (i == selected) {
          style.color(out, "\x1b[1m");
        }
        if (i == selected + 3) {
          style.color(out, "\x1b[22m");
        }
        out.append_char(text.at(i));
      }
      style.color(out, "\x1b[0m");
      out.append(" ");
      style.edge(out, "│", "|");
      out.append("\r\n");
    }

    /* Renders the shared scale, time axis, and color legend for current leaders. */
    method draw(a: const ref HeapAllocator, out: ref String, style: ref TableStyle, history: ref History, memory: bool, height: i64) void throws IError {
      var peak = this.scale(history, memory);
      var canvas = DotCanvas(a, style.width - 13, height);
      for (var i = this.series.size(); i > 0; i = i - 1) {
        this.trace(canvas, history, this.series.get(i - 1), memory, peak);
      }
      style.rule(out, 0, false);
      this.header(a, out, style, memory);
      style.rule(out, 1, false);
      for (var row: i64 = 0; row < height; row = row + 1) {
        this.plot_row(a, out, style, canvas, row, peak);
      }
      var begin = this.begin(history) - history.origin;
      var axis = String("elapsed  +");
      axis.append(decimal(_convert<f64>(begin) / 1000.0));
      axis.append("s");
      var right = String("+");
      right.append(decimal(_convert<f64>(begin + this.duration) / 1000.0));
      right.append("s");
      var left = padded(axis, style.width - 4 - right.length());
      left.append(right);
      style.panel_line(a, out, left, false);
      style.rule(out, 1, false);
      this.legend(a, out, style);
      style.rule(out, 2, false);
    }
  }
}
