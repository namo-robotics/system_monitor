/** Versioned JSON Lines recording and bounded streaming replay. */
public module system_monitor {

  using std;

  /** Describes the recording version, cadence, and measurement units. */
  function metadata(a: ref HeapAllocator, o: ref Options) Result<String> {
    var j = try std.json.create_json_object(a);
    try j.set(try String("version"), std.json.Json(1i64));
    try j.set(
      try String("type"),
      std.json.Json(try String("session"))
    );
    try j.set(try String("interval_ms"), std.json.Json(o.interval));
    try j.set(
      try String("cpu_unit"),
      std.json.Json(try String("percent_one_core"))
    );
    try j.set(
      try String("memory_unit"),
      std.json.Json(try String("bytes_rss"))
    );
    try j.set(
      try String("timestamp_unit"),
      std.json.Json(try String("unix_ms"))
    );
    return Result.Ok(try j.to_string(a));
  }

  /** Writes one complete JSON line and reports storage failures. */
  function write_record(file: ref std.io.File, text: ref String) Result<void> {
    var line = try String("");
    try line.append(text);
    try line.append("\n");
    if ((file.write(line)) != line.length()) {
      return Result.Error(Error(1, "recording write failed"));
    }

    return Result.Ok;
  }

  /** Reads a recording incrementally with bounded line buffering. */
  class Replay {
    var file: std.io.File = std.io.File();
    var pending: String;
    var eof: bool = false;
    var last_elapsed: i64 = -1;

    /** Reads the next complete line, ignoring an interrupted final fragment. */
    method line(a: ref HeapAllocator) Result<String> {
      while (true) {
        match this.pending.find_char(10u8) {
          Option.Some(n) => {
            var line = try this.pending.substr(a, 0, n);
            this.pending = try 
              this.pending.substr(a, n + 1, this.pending.length() - n - 1)
            ;
            return Result.Ok(line);
          },
          Option.None => {}
        };
        if (this.eof) {
          this.pending.clear();
          return Result.Ok(try String(""));
        }
        var buffer = try ContiguousBuffer<u8>(a, 65536);
        var n = unsafe { this.file.read_into(buffer.raw_data(), buffer.size()); };
        if (n < 0) {
          return Result.Error(Error(1, "recording read failed"));
        }
        if (n == 0) {
          this.eof = true;
          continue;
        }
        var text = try String(a, buffer, n);
        try this.pending.append(text);
        if (this.pending.length() > 67108864) {
          return Result.Error(Error(1, "recording line exceeds limit"));
        }
      }
      return Result.Ok(try String(""));
    }

    /** Initializes owned storage and reports allocation failure. */
    init() std.AllocationResult<void> {
      this.pending = try String("");
    }
  }
}
