/** Checks signalling against disposable children and rejects unsafe UI actions. */
public module system_monitor {

  using std;

  /** Creates a disposable child for native signal tests. */
  extern "C" function test_fork() i32 as "fork";

  /** Keeps the child alive without allocating after fork. */
  extern "C" function test_sleep(seconds: u32) u32 as "sleep";

  /** Exits the child without running inherited cleanup handlers. */
  extern "C" function test_exit(code: i32) void as "_exit";

  /** Reaps the child and returns its termination status. */
  extern "C" function test_waitpid(pid: i32, status: raw_ptr<i32>, flags: i32) i32 as "waitpid";

  /** Verifies stale identities fail and supported signals reach only the child. */
  test_function signals_recheck_child_identity() MonitorTestResult<void> {
    var a = make_heap_allocator();
    for (var i: i32 = 0; i < 2; i = i + 1) {
      var pid = unsafe { test_fork(); };
      if (pid == 0) {
        unsafe { test_sleep(10); test_exit(0); };
        return MonitorTestResult.Ok;
      }
      try std.test.assert(pid > 1, "child created");
      var frame = try collect(a, 0);
      var start: i64 = -1;
      for (var row: i64 = 0; row < frame.processes.size(); row = row + 1) {
        if ((try vector_read(frame.processes, row)).pid == _convert<i64>(pid)) {
          start = (try vector_read(frame.processes, row)).start;
        }
      }
      var stale = try control_process(a, _convert<i64>(pid), start + 1, 15);
      var signal: i32 = 15;
      if (i == 1) {
        signal = 9;
      }
      var sent = try control_process(a, _convert<i64>(pid), start, signal);
      var status: i32 = 0;
      var reaped = unsafe { test_waitpid(pid, _address_of<i32>(status), 0); };
      try std.test.assert(start >= 0, "child identity available");
      try std.test.assert(
        stale.equals_literal("Signal failed: process exited, changed, or permission denied"),
        "stale identity rejected"
      );
      try std.test.assert_eq(reaped, pid);
      try std.test.assert_eq(status & 127, signal);
    }

    return MonitorTestResult.Ok;
  }

  /** Blocks replay, empty selections, special PIDs, and signalling the monitor. */
  test_function process_actions_validate_targets() MonitorTestResult<void> {
    var a = make_heap_allocator();
    var terminal = try Terminal(a, false);
    var options = Options();
    options.monitor = try String("process");
    terminal.apply_key(b't', options);
    try terminal.perform_action(a, options);
    try std.test.assert(
      terminal.notice.equals_literal("Select a visible process before sending a signal"),
      "empty selection rejected"
    );
    options.replay = try String("session.jsonl");
    terminal.apply_key(b'k', options);
    try terminal.perform_action(a, options);
    try std.test.assert(
      terminal.notice.equals_literal("Process actions are disabled during replay"),
      "replay rejected"
    );
    try std.test.assert_eq(terminal.pending_signal, 0i32);
    var group = try control_process(a, 0, 0, 9);
    var init = try control_process(a, 1, 0, 9);
    var own = try control_process(a, _convert<i64>(unsafe { pm_getpid(); }), 0, 9);
    try std.test.assert(group.equals_literal("Cannot signal this PID"), "group rejected");
    try std.test.assert(init.equals_literal("Cannot signal this PID"), "init rejected");
    try std.test.assert(own.equals_literal("Cannot signal this PID"), "self rejected");

    return MonitorTestResult.Ok;
  }
}
