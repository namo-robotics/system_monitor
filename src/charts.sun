/** Pure formatting helpers and sampled terminal history graphs. */
public module system_monitor {

  using std;

  /** Bounds text length and removes terminal control characters. */
  function safe_text(a: const ref HeapAllocator, s: const ref String, width: i64) Result<String> {
    var out = try String("");
    for (var i: i64 = 0; i < s.length() and i < width; i = i + 1) {
      var ch = try s.at(i);
      if (ch >= 32u8 and ch < 127u8) {
        try out.append_char(ch);
      } else {
        try out.append("?");
      }
    }
    return Result.Ok(out);
  }

  /** Formats an available measurement with a decimal digit or an unavailable marker. */
  function decimal(value: f64) std.AllocationResult<String> {
    if (value < 0.0) {
      return std.AllocationResult.Ok(try String("N/A"));
    }
    var n = _convert<i64>(value * 10.0);
    var out = try String("");
    try out.append(n / 10);
    try out.append(".");
    try out.append(n % 10);
    return std.AllocationResult.Ok(out);
  }

  /** Pads a formatted value to its display column width. */
  function padded(s: const ref String, width: i64) std.AllocationResult<String> {
    var out = try String("");
    try out.append(s);
    while (out.length() < width) {
      try out.append(" ");
    }
    return std.AllocationResult.Ok(out);
  }

  /** Reads one resource value for a stable identity without allocating strings. */
  function history_value(f: ref Frame, pid: i64, start: i64, memory: bool) Result<f64> {
    for (var i: i64 = 0; i < f.processes.size(); i = i + 1) {
      var p: ref Process = try f.processes.get(i);
      if (p.pid == pid and p.start == start) {
        if (not memory) {
          return Result.Ok(p.cpu);
        }
        if (p.rss < 0) {
          return Result.Ok(-1.0);
        }
        return Result.Ok(_convert<f64>(p.rss) / 1048576.0);
      }
    }
    return Result.Ok(-1.0);
  }
}
